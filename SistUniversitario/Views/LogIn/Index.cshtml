@{
    Layout = null;

    ///Contruir la URL del método controlador

    string urlMetodoFormulario = Url.Action("VerificaLogin", "Login");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Ingreso - Sistema Universitario</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
    <script src="@Url.Content("~/Scripts/modernizr-2.8.3.js")"></script>
</head>
<body>
    @*
        Crear el formulario e indicarle el action y el método
        action=variable creada en la línea 4
        method = debe ser post ya que el get nos retornaria la vista
    *@
    <main class="login-shell">
        <form class="login-card" action="@urlMetodoFormulario" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="control-label col-sm-2"></label>
                <div class="col-sm-10">
                    <h1>Inicio de sesión</h1>
                    <p>Ingrese sus credenciales para continuar.</p>
                </div>
            </div>

            @*
                Recordar que la propiedad "name" de cada uno de los objetos HTML
                   son los que toman en cuenta en el controlador para asignarle
                   las propiedades al modelo
            *@


            <div class="form-group">
                <label class="control-label col-sm-2" for="correoElectronico">Correo electrónico</label>
                <div class="control-label col-sm-10">
                    <input type="email" class="form-control" id="correoElectronico" name="correoElectronico" placeholder="nombre@universidad.ac.cr" required autocomplete="username" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-sm-2" for="contrasena">Contraseña</label>
                <div class="control-label col-sm-10">
                    <input type="password" class="form-control" id="contrasena" name="contrasena" placeholder="Ingrese la contraseña" required autocomplete="current-password" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="submit" class="btn btn-primary">Ingresar</button>
                </div>
            </div>

            @*
                Mostrar los mensajes que enviamos desde el controlador. Por ejemplo(ver controlador)
                      this.ModelState.AddModelError("", "Usuario o contraseña inválidos. Por favor verifique");
            *@

            @Html.ValidationSummary(true);
        </form>
    </main>

    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
</body>
</html>
