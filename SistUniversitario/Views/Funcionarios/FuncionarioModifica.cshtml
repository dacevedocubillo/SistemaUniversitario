@model SistUniversitario.Models.saRetornaFuncionario_ID_Result

@{
    ViewBag.Title = "FuncionarioModifica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Funcionario Modifica</h2>

<form id="frmfuncionario" method="post">

    <input type="hidden" name="id_funcionario" id="id_funcionario" value="@Model.id_funcionario" />
    <div class="form-group">
        <label>Funcionario:</label>
        <input type="text" name="nombre" id="nombre" class="form-control" value="@Model.nombre" />
    </div>

    <div class="form-group">
        <label>Cédula:</label>
        <input type="text" name="cedula" id="cedula" class="form-control" value="@Model.cedula" />
    </div>

    <div class="form-group">
        <label>Provincia:</label>
        <select name="id_provincia" id="id_provincia" class="form-control" value="@Model.id_provincia"></select>
    </div>

    <div class="form-group">
        <label>Cantón:</label>
        <select name="id_canton" id="id_canton" class="form-control" value="@Model.id_canton"></select>
    </div>

    <div class="form-group">
        <label>Distrito:</label>
        <select name="id_distrito" id="id_distrito" class="form-control" value="@Model.id_distrito"></select>
    </div>

    <div class="form-group">
        <label>Fecha de contratacion :</label>
        <input type="text" name="fecha_contratacion" id="fecha_contratacion" class="form-control" value="@Model.fecha_contratacion" />
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" id="btnAceptar" />
    </div>

    <a href="~/Funcionarios/ListaFuncionarios">Regresar a la lista</a>

</form>


@section scripts{
    @* *****No es necesario incluir jquery porque
        ya el layout lo incluye*@


    <script src="~/Scripts/Funcionarios/Funcionario.js"></script>
    <script src="~/Scripts/ScriptGenericos.js"></script>
}

