
@model SistUniversitario.Models.saRetornaCurso_ID_Result

@{
    ViewBag.Title = "CursoElimina";
}

<h2>CursoElimina</h2>

<form id="frmCursoNuevo" method="post">

    <input type="hidden" name="idCurso" id="idCurso" value="@Model.idCurso"  readonly/>

    <div class="form-group">
        <label>Codigo:</label>
        <input type="text" name="codigo" id="codigo" class="form-control" value="@Model.Codigo" readonly />
    </div>

    <div class="form-group">
        <label>Curso :</label>
        <input type="text" name="nombreCurso" id="nombreCurso" class="form-control" value="@Model.nombreCurso" readonly />
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" id="btnAceptar" />
    </div>

    <a href="~/Cursos/ListaCurso">Regresar a la lista</a>

</form>


@section scripts{

    <script src="~/Scripts/Cursos/CursoNuevo.js"></script>
}
