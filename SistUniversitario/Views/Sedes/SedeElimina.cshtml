
@model  SistUniversitario.Models.saRetornaSede_ID_Result

@{
    ViewBag.Title = "SedeElimina";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Sede Elimina</h2>

<form id="frmSede" method="post">
    <input type="hidden" name="idSedeuniversitaria" id="idSedeuniversitaria" value="@Model.idSedeuniversitaria" />


    <div class="form-group">
        <label>Nombre:</label>
        <input type="text" name="nombre" id="nombre" class="form-control" value="@Model.nombre" readonly />
    </div>

    <div class="form-group">
        <label>Codigo:</label>
        <input type="text" name="codigo" id="codigo" class="form-control" value="@Model.codigo" readonly />
    </div>

    <div class="form-group">
        <label>Funcionario :</label>
        <select name="id_funcionario" id="id_funcionario" class="form-control" readonly>
            <option value="">Seleccione un Funcionario</option>
            @{
                foreach (SistUniversitario.Models.RetornaFuncionario_Result funcionario in this.ViewBag.ListaFuncionario)
                {
                    bool esIdfunciModelo = funcionario.id_funcionario == Model.id_funcionario;

                    @*
                        Incluir propiedad

                    *@
                    if (esIdfunciModelo)
                    {

                        <option value="@funcionario.id_funcionario" selected>@funcionario.nombre.ToUpper()</option>
                    }
                    else
                    {
                        <
                        <option value="@funcionario.id_funcionario">@funcionario.nombre.ToUpper()</option>

                    }

                }

            }
        </select>
    </div>

    <div class="form-group">
        <label>Provincia:</label>
        <select name="id_provincia" id="id_provincia" class="form-control" value="@Model.id_provincia" readonly>

            @{
                foreach (SistUniversitario.Models.RetornaProvincias_Result provincia
                    in this.ViewBag.ListaProvincias)
                {
                    bool esIdProvinciaModelo = provincia.id_Provincia == Model.id_provincia;

                    @*
                        Incluir propiedad

                    *@
                    if (esIdProvinciaModelo)
                    {
                        <option value="@provincia.id_Provincia" selected>@provincia.nombre.ToUpper() </option>

                    }
                    else
                    {
                        <option value="@provincia.id_Provincia">@provincia.nombre.ToUpper() </option>

                    }

                }

            }

        </select>
    </div>

    <div class="form-group">
        <label>Cantón:</label>
        <select name="id_canton" id="id_canton" class="form-control" value="@Model.id_canton" readonly>


            @{
                foreach (SistUniversitario.Models.RetornaCantones_Result canton
                    in this.ViewBag.ListaCantones)
                {
                    bool esIdCantonModelo = canton.id_Canton == Model.id_canton;

                    @*
                        Incluir propiedad

                    *@
                    if (esIdCantonModelo)
                    {
                        <option value="@canton.id_Canton" selected>@canton.nombre.ToUpper() </option>

                    }
                    else
                    {
                        <option value="@canton.id_Canton">@canton.nombre.ToUpper() </option>

                    }

                }

            }


        </select>
    </div>

    <div class="form-group">
        <label>Distrito:</label>
        <select name="id_distrito" id="id_distrito" class="form-control" value="@Model.id_distrito" readonly>


            @{
                foreach (SistUniversitario.Models.RetornaDistritos_Result distrito in this.ViewBag.ListaDistrito)
                {
                    bool esIdDistritoModelo = distrito.id_Distrito == Model.id_distrito;
                    @*
                        Incluir propiedad

                    *@
                    if (esIdDistritoModelo)
                    {
                        <option value="@distrito.id_Distrito" selected>@distrito.nombre.ToUpper() </option>

                    }
                    else
                    {
                        <option value="@distrito.id_Distrito">@distrito.nombre.ToUpper() </option>

                    }

                }

            }
        </select>
    </div>

    <div class="form-group">
        <label>Direccion Fisica :</label>
        <input type="text" name="DireccionFisica" id="DireccionFisica" class="form-control" value="@Model.DireccionFisica" readonly />
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" id="btnAceptar" />
    </div>

    <a href="~/Sedes/ListaSedes">Regresar a la lista</a>

</form>
