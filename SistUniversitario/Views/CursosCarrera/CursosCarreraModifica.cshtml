@model SistUniversitario.Models.saRetornaCursosCarrera_ID_Result


@{
    ViewBag.Title = "CursosCarreraModifica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Cursos Carrera Modifica</h2>

<form id="frmCursoCarrera" method="post">

    <input type="hidden" name="idCurso" id="idCurso" value="@Model.id_cursoscarrera" />

    <div class="form-group">
        <label>Carrera :</label>
        <select name="id_carrera" id="id_carrera" class="form-control" value="@Model.id_carrera">
            <option value="">Seleccione una Carrera</option>
            @{

                foreach (SistUniversitario.Models.RetornaCarrera_Result carrera in this.ViewBag.ListaCarrera)
                {
                    <option value="@carrera.idCuniversitaria">@carrera.Nombre</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label>Cursos :</label>
        <select name="id_curso" id="id_curso" class="form-control" value="@Model.id_curso">
            <option value="">Seleccione un Curso</option>
            @{

                foreach (SistUniversitario.Models.RetornaCurso_Result curso in this.ViewBag.ListaCursos)
                {
                    <option value="@curso.idCurso">@curso.nombreCurso</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <input type="submit" value="Guardar" id="btnAceptar" />
    </div>

    <a href="~/CursosCarrera/ListaCursosCarrera">Regresar a la lista</a>
</form>




@section scripts{


    <script src="~/Scripts/CursosCarrera/CusosCarrera.js"></script>
}
